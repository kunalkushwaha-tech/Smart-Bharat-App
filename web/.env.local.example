# Server-only AI provider key.
GROQ_API_KEY=
# Server-only OpenAI-compatible AI provider key.
OPENAI_API_KEY=
# Server-only OpenAI-compatible model name.
OPENAI_MODEL=
# Server-only WHOISXML API key.
WHOISXML_API_KEY=
# Server-only Google Safe Browsing API key.
GOOGLE_SAFE_BROWSING_API_KEY=
# Server-only VirusTotal API key.
VIRUSTOTAL_API_KEY=
# Server-only Supabase service-role key.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only Sentry DSN.
SENTRY_DSN=
# Server-only secret used to sign stateless certificate IDs.
CERT_SIGNING_SECRET=replace-with-a-long-random-secret
# Server-only application URL used for CORS when configured.
APP_URL=

# Public Supabase project URL used by the browser and same-origin routes.
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase anonymous key used by the browser and same-origin routes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional browser-side Sentry DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Public application URL used for CORS when configured.
NEXT_PUBLIC_APP_URL=
# Public support contact address.
NEXT_PUBLIC_CONTACT_EMAIL=
